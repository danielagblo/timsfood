# Copy to .env and fill in your MySQL credentials.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=timsfood

# Optional server settings
PORT=5173
HOST=127.0.0.1

# Admin portal login (created on first start)
ADMIN_EMAIL=admin@timsfoods.local
ADMIN_PASSWORD=

# Paystack (online payments — optional if you only use pay-on-delivery)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_BASE=http://127.0.0.1:5173
PAYSTACK_CURRENCY=GHS
# Set this to the webhook signing secret from the Paystack dashboard
PAYSTACK_WEBHOOK_SECRET=
# Only needed for local testing against a fake Paystack API
# PAYSTACK_API_BASE=http://127.0.0.1:5200

# Separate hosting only
# CLIENT_ORIGIN=https://your-client.vercel.app
# COOKIE_SAME_SITE=None
# CLIENT_DIR=../client
